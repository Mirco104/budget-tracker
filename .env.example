# Copy to .env and replace every placeholder. Never commit .env.

# Password of the PostgreSQL user "budget"
DB_PASSWORD=change-me

# First admin, created on the first start when no user exists (US15); password at least 12 characters
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me-at-least-12
ADMIN_DISPLAY_NAME=Admin

# Domain for HTTPS with Caddy (docker compose --profile https up -d)
DOMAIN=budget.example.test

# Only for a test over plain HTTP in the home network: SESSION_COOKIE_SECURE=false and APP_BIND=0.0.0.0
SESSION_COOKIE_SECURE=true
APP_BIND=127.0.0.1
